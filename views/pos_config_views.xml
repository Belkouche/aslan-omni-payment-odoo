<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_aslan_omni" model="ir.ui.view">
        <field name="name">pos.config.form.aslan.omni</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_setting_box')]" position="inside">
                <div class="app_settings_block" data-string="Aslan Omni" string="Aslan Omni">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="aslan_omni_api_url" string="Aslan API URL"/>
                                <field name="aslan_omni_api_url" placeholder="https://api.aslanpay.ma"/>

                                <label for="aslan_omni_device_id" string="Device ID"/>
                                <field name="aslan_omni_device_id" readonly="1" placeholder="(pair terminal to fill)"/>

                                <label for="aslan_omni_api_key" string="API Key"/>
                                <field name="aslan_omni_api_key" password="True" readonly="1"
                                       placeholder="(pair terminal to fill)"/>

                                <label string="Associer le terminal"
                                       attrs="{'invisible': [('aslan_omni_device_id', '!=', False)]}"/>
                                <field name="aslan_omni_pair_widget" widget="aslan_omni_pairing" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
