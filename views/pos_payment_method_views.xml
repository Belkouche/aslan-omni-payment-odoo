<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_aslan_omni" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.aslan.omni</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook invisible="payment_provider not in ('aslan_omni', 'aslan_cash')">
                    <page name="aslan_omni_settings" string="Aslan Omni (card)" invisible="payment_provider != 'aslan_omni'">
                        <group>
                            <field name="aslan_omni_api_url" invisible="payment_provider != 'aslan_omni'"/>
                            <field name="aslan_omni_device_id" readonly="1" invisible="payment_provider != 'aslan_omni'"/>
                            <field name="aslan_omni_api_key" password="True" readonly="1" invisible="payment_provider != 'aslan_omni'"/>
                            <field name="aslan_omni_print_merchant_receipt" invisible="payment_provider != 'aslan_omni'"/>
                            <field name="aslan_omni_pair_widget" widget="aslan_omni_pairing" nolabel="1" invisible="payment_provider != 'aslan_omni'"/>
                        </group>
                    </page>
                    <page name="aslan_cash_settings" string="Aslan Omni (cash recycler)" invisible="payment_provider != 'aslan_cash'">
                        <group>
                            <field name="aslan_omni_api_url" invisible="payment_provider != 'aslan_cash'"/>
                            <field name="aslan_omni_device_id" readonly="1" invisible="payment_provider != 'aslan_cash'"/>
                            <field name="aslan_omni_api_key" password="True" readonly="1" invisible="payment_provider != 'aslan_cash'"/>
                            <field name="aslan_cash_tips_enabled" invisible="payment_provider != 'aslan_cash'"/>
                            <field name="aslan_omni_pair_widget" widget="aslan_omni_pairing" nolabel="1" invisible="payment_provider != 'aslan_cash'"/>
                        </group>
                        <div class="text-muted" invisible="payment_provider != 'aslan_cash'">
                            <p>The cash method drives a paired Cashmatic recycler through the same
                            Aslan Omni terminal as the card method. Pair a terminal here to set
                            the device ID and API key — a merchant's recycler is bound to the
                            terminal, not to a specific payment method.</p>
                            <p>Cash is only available on terminals whose acquirer supports it (NAPS Pay);
                            VPS-acquirer terminals cannot host a recycler and the method is hidden
                            on their tills.</p>
                        </div>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
