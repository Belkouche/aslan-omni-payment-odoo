<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="aslan_omni.ReceiptCardBlock" owl="1">
        <div class="aslan-omni-receipt-card"
             style="border-top:1px dashed #ccc;margin-top:8px;padding-top:8px;font-size:11px;">
            <div style="text-align:center;font-weight:bold;margin-bottom:4px;">PAIEMENT PAR CARTE</div>
            <t t-if="props.cardScheme">
                <div>Carte : <t t-esc="props.cardScheme"/>
                    <t t-if="props.cardNumber"> <t t-esc="props.cardNumber"/></t>
                </div>
            </t>
            <t t-if="props.authNumber">
                <div>Auth : <t t-esc="props.authNumber"/></div>
            </t>
            <t t-if="props.rrn">
                <div>RRN : <t t-esc="props.rrn"/></div>
            </t>
        </div>
    </t>

    <t t-name="point_of_sale.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <t t-foreach="props.order.payment_ids" t-as="line" t-key="line.uuid">
                <t t-if="line.payment_method.use_payment_terminal === 'aslan_omni' and line.aslan_omni_result">
                    <AslanOmniReceiptCardBlock
                        cardScheme="line.aslan_omni_result.cardScheme"
                        cardNumber="line.aslan_omni_result.cardNumber"
                        authNumber="line.aslan_omni_result.authNumber"
                        rrn="line.aslan_omni_result.rrn"
                    />
                </t>
            </t>
        </xpath>
    </t>
</templates>
