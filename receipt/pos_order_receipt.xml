<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Customer copy of the card slip, appended under the regular order receipt. -->
        <template id="aslan_omni_payment.pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
            <xpath expr="//t[@t-call='point_of_sale.pos_order_receipt_footer']" position="after">
                <t t-foreach="payments" t-as="payment" name="aslan_omni_card_details">
                    <div t-if="payment.get('aslan_omni_result')" class="mt-3" style="border-top:1px dashed #000;padding-top:8px;">
                        <t t-call="aslan_omni_payment.card_slip_body" />
                        <div class="text-center">Copie client</div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
