<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="aslan_omni_payment.CashTipPicker">
        <div class="modal-dialog modal-dialog-centered aslan-cash-tip-picker" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pourboire</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Montant de la vente : <strong t-out="this.props.formatCurrency(this.props.baseAmount)"/>
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <t t-foreach="this.presets" t-as="tip" t-key="tip">
                            <button type="button" class="btn"
                                    t-att-class="this.isPresetActive(tip) ? 'btn-primary' : 'btn-outline-primary'"
                                    t-on-click="() => this.pickPreset(tip)">
                                <t t-if="tip === 0">Pas de pourboire</t>
                                <t t-else=""><t t-out="tip"/> MAD</t>
                            </button>
                        </t>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Autre montant (MAD)</label>
                        <input type="number" min="0" step="0.5" class="form-control"
                               t-att-value="this.state.customText"
                               t-on-input="this.onCustomInput"
                               placeholder="0.00"/>
                    </div>
                    <p class="mt-3">
                        Total à encaisser (vente + pourboire) :
                        <strong t-out="this.props.formatCurrency(this.totalWithTipCents / 100)"/>
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" t-on-click="this.cancel">Annuler</button>
                    <button type="button" class="btn btn-primary" t-on-click="this.confirm">Démarrer le paiement</button>
                </div>
            </div>
        </div>
    </t>
</templates>
