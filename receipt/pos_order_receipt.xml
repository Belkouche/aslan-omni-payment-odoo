<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Customer copies of Aslan Omni slips, appended under the regular order receipt. -->
        <template id="aslan_omni_payment.pos_order_receipt" inherit_id="point_of_sale.pos_order_receipt">
            <xpath expr="//t[@t-call='point_of_sale.pos_order_receipt_footer']" position="after">
                <t t-foreach="payments" t-as="payment" name="aslan_omni_details">
                    <!-- Card (Aslan Omni) customer copy -->
                    <div t-if="payment.get('aslan_omni_result')" class="mt-3" style="border-top:1px dashed #000;padding-top:8px;">
                        <t t-call="aslan_omni_payment.card_slip_body" />
                        <div class="text-center">Copie client</div>
                    </div>
                    <!-- Browser printing only: merchant copy on its own page (see pos_ticket_printer_plugin.js). -->
                    <div t-if="payment.get('aslan_omni_merchant_inline')" style="break-before:page;page-break-before:always;">
                        <t t-call="aslan_omni_payment.card_slip_body" />
                        <div class="text-center">Copie commerçant - A conserver</div>
                    </div>
                    <!-- Cash (Cashmatic) slip: the recycler is standalone, so one slip only — cashier keeps the till totals. -->
                    <div t-if="payment.get('aslan_cash_result')" class="mt-3" style="border-top:1px dashed #000;padding-top:8px;">
                        <t t-call="aslan_omni_payment.cash_slip_body" />
                        <div class="text-center">Copie client</div>
                    </div>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
